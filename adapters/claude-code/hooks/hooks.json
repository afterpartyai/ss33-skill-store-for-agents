{
  "description": "ss33: suggest a relevant Skill Store skill from the prompt (silent on any failure); fetch the Node.js runtime in the background if none is installed",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ss33\" __prefetch-runtime",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ss33\" hook claude-code user-prompt-submit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
